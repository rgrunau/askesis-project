---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
}).format(new Date(`${date}T12:00:00`));
---

<BaseLayout title={`${article.data.title} — The Askesis Project`} description={article.data.description} currentPage="/articles">
  <article>
    <header class="article-header wrapper">
      <a href="/articles" class="back-link">← All articles</a>
      <div class="article-meta"><span>λόγος / article</span><time datetime={article.data.publishedAt}>{formatDate(article.data.publishedAt)}</time></div>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
    </header>
    <div class="article-rule"></div>
    <div class="article-body wrapper"><Content /></div>
  </article>
  <NewsletterSignup source={`article-${article.slug}`} />
</BaseLayout>

<style>
  .article-header { max-width: 940px; padding-top: 72px; padding-bottom: 76px; }
  .back-link { display: inline-block; color: var(--text-muted); font: 11px/1 var(--mono); letter-spacing: .08em; text-decoration: none; margin-bottom: 90px; }.back-link:hover { color: var(--accent); }
  .article-meta { display: flex; justify-content: space-between; gap: 20px; color: var(--accent); font: 10px/1 var(--mono); text-transform: uppercase; letter-spacing: .15em; margin-bottom: 28px; }
  h1 { font-size: clamp(52px, 7vw, 92px); line-height: .97; letter-spacing: -.04em; font-weight: 350; margin: 0 0 28px; text-wrap: balance; }
  .article-header > p { color: var(--text-body); font-size: 21px; line-height: 1.55; max-width: 650px; margin: 0; }
  .article-rule { height: 1px; background: var(--line); }
  .article-body { max-width: 800px; padding-top: 84px; padding-bottom: 130px; font-size: 21px; line-height: 1.78; color: var(--text-body); }
  .article-body :global(p) { margin: 0 0 1.55em; }.article-body :global(h2) { color: var(--text); font-size: 38px; line-height: 1.2; font-weight: 400; margin: 2em 0 .7em; }
  .article-body :global(h3) { color: var(--text); font-size: 28px; font-weight: 400; margin: 1.8em 0 .6em; }.article-body :global(em), .article-body :global(a) { color: var(--accent); }
  .article-body :global(a) { text-underline-offset: 4px; }.article-body :global(blockquote) { margin: 2.2em 0; padding: 8px 0 8px 30px; border-left: 1px solid var(--accent); color: var(--text); font-size: 29px; line-height: 1.45; }
  .article-body :global(li) { margin-bottom: .55em; }.article-body :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 3em 0; }
  @media (max-width: 640px) { .article-header { padding-top: 48px; padding-bottom: 58px; }.back-link { margin-bottom: 64px; }.article-body { padding-top: 62px; padding-bottom: 90px; font-size: 19px; }.article-meta { flex-direction: column; } }
</style>
