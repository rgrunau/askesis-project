---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hero, definition, pillars, fieldNote } from '../data/home';
---

<BaseLayout title="The Askesis Project" currentPage="/">
  <section class="home-hero">
    <div class="hero-trace" aria-hidden="true">
      <span class="trace trace-one"></span><span class="trace trace-two"></span><span class="trace trace-three"></span><span class="trace trace-four"></span>
      <span class="trace-axis"></span><span class="trace-label">σῶμα / 0001</span>
    </div>
    <div class="wrapper hero-inner">
      <div class="hero-copy">
        <div class="kicker" set:html={hero.eyebrow} />
        <h1 set:html={hero.heading.replace('\n', '<br>')} />
        <p>{hero.body}</p>
        <div class="hero-actions">
          {hero.ctas.map((cta) => <a href={cta.href} class={cta.external ? 'btn-outline' : 'btn-primary'} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener' : undefined}>{cta.label}</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="definition-section">
    <div class="wrapper definition-grid">
      <div class="section-index"><span>01</span><span>{definition.label}</span></div>
      <div class="definition-copy"><p class="definition-lead" set:html={definition.lead} /><p>{definition.body}</p></div>
    </div>
  </section>

  <section class="practice-section">
    <div class="wrapper">
      <header class="section-heading">
        <div><span class="section-index">02</span><h2>{pillars.heading}</h2></div><span>{pillars.subheading}</span>
      </header>
      <div class="practice-sequence">
        {pillars.items.map((pillar, index) => (
          <article class="practice-card">
            <div class="practice-meta"><span>0{index + 1}</span><span>{pillar.glyph}</span></div>
            <div class={`practice-mark practice-mark-${index + 1}`} aria-hidden="true">{Array.from({ length: index === 0 ? 7 : index === 2 ? 49 : 1 }).map(() => <i></i>)}</div>
            <h3>{pillar.title}</h3><p>{pillar.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="field-note-section">
    <div class="wrapper field-note-grid">
      <div class="field-note-label"><span>Field note / 0001</span><span>ἦθος</span></div>
      <blockquote><p>{fieldNote.statement}</p><footer>{fieldNote.note}</footer></blockquote>
      <div class="impact-field" aria-hidden="true">{Array.from({ length: 81 }).map((_, index) => <i style={`--i:${index}`}></i>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { min-height: 760px; position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-inner { min-height: 680px; padding-top: 122px; padding-bottom: 96px; position: relative; display: flex; align-items: center; }
  .hero-copy { position: relative; z-index: 2; max-width: 780px; }
  .kicker { font-family: var(--mono); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--accent); margin-bottom: 34px; }
  h1 { max-width: 850px; margin: 0 0 32px; font-size: clamp(56px, 7.1vw, 102px); font-weight: 350; line-height: .94; letter-spacing: -.045em; text-wrap: balance; }
  h1 :global(em) { color: var(--accent); font-weight: 300; }
  .hero-copy > p { max-width: 590px; margin: 0 0 40px; color: var(--text-body); font-size: 20px; line-height: 1.58; }
  .hero-actions { display: flex; gap: 14px; }
  .hero-trace { position: absolute; inset: 0 0 0 48%; opacity: .78; pointer-events: none; }
  .trace { position: absolute; top: 8%; right: 5%; width: min(50vw, 650px); aspect-ratio: 1; border: 1px solid rgba(201,138,110,.22); border-radius: 47% 53% 45% 55% / 52% 46% 54% 48%; transform: rotate(-18deg); }
  .trace-two { top: 10%; right: 3%; border-color: rgba(236,229,214,.13); border-radius: 53% 47% 51% 49% / 46% 55% 45% 54%; transform: rotate(19deg) scale(.93); }
  .trace-three { top: 13%; right: 7%; border-color: rgba(201,138,110,.15); border-radius: 49% 51% 44% 56% / 55% 47% 53% 45%; transform: rotate(51deg) scale(.86); }
  .trace-four { top: 17%; right: 4%; border-color: rgba(236,229,214,.075); border-radius: 56% 44% 52% 48% / 47% 54% 46% 53%; transform: rotate(-37deg) scale(.77); }
  .trace-axis { position: absolute; width: 1px; height: 78%; top: 11%; left: 52%; background: linear-gradient(transparent, var(--line), transparent); transform: rotate(14deg); }
  .trace-label { position: absolute; right: 5%; bottom: 9%; font-family: var(--mono); font-size: 10px; letter-spacing: .16em; color: var(--text-faint); }
  .definition-section { background: var(--bg-alt); border-bottom: 1px solid var(--line); }
  .definition-grid { display: grid; grid-template-columns: 190px 1fr; gap: 64px; padding-top: 104px; padding-bottom: 108px; }
  .section-index { font-family: var(--mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); display: flex; gap: 18px; }
  .definition-copy { max-width: 830px; }
  .definition-lead { margin: 0 0 30px; font-size: clamp(29px, 3.1vw, 44px); line-height: 1.25; letter-spacing: -.02em; }
  .definition-lead :global(em) { color: var(--accent); }
  .definition-copy > p:last-child { margin: 0; max-width: 660px; color: var(--text-body); font-size: 18px; line-height: 1.7; }
  .practice-section { padding: 110px 0 120px; }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .section-heading > div { display: flex; gap: 28px; align-items: baseline; }
  .section-heading h2 { margin: 0; font: 500 14px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .section-heading > span { font: 11px/1 var(--mono); color: var(--text-muted); letter-spacing: .1em; }
  .practice-sequence { display: grid; grid-template-columns: repeat(3, 1fr); }
  .practice-card { min-height: 470px; padding: 30px 30px 38px; border-right: 1px solid var(--line); }
  .practice-card:first-child { border-left: 1px solid var(--line); }
  .practice-meta { display: flex; justify-content: space-between; font: 10px/1 var(--mono); letter-spacing: .14em; color: var(--text-muted); }
  .practice-meta span:last-child { color: var(--accent); font-family: 'Newsreader', serif; font-size: 21px; }
  .practice-mark { height: 165px; margin: 28px 0 24px; position: relative; display: grid; place-items: center; }
  .practice-mark i { display: block; width: 58px; height: 58px; border: 1px solid var(--accent); border-radius: 51% 47% 54% 44%; }
  .practice-mark-1 { display: flex; justify-content: center; align-items: center; padding-left: 28px; }
  .practice-mark-1 i { width: 54px; height: 54px; flex: 0 0 54px; margin-left: -35px; border-color: rgba(201,138,110,.38); transform: rotate(-8deg) scale(.82); }
  .practice-mark-1 i:nth-child(2) { transform: translateY(-2px) rotate(13deg) scale(.87); opacity: .62; }
  .practice-mark-1 i:nth-child(3) { transform: translateY(2px) rotate(-17deg) scale(.92); opacity: .7; }
  .practice-mark-1 i:nth-child(4) { transform: translateY(-1px) rotate(21deg) scale(.97); opacity: .79; }
  .practice-mark-1 i:nth-child(5) { transform: translateY(1px) rotate(-12deg) scale(1.02); opacity: .87; }
  .practice-mark-1 i:nth-child(6) { transform: translateY(-2px) rotate(15deg) scale(1.08); opacity: .94; }
  .practice-mark-1 i:nth-child(7) { transform: rotate(-6deg) scale(1.15); border-color: var(--accent); box-shadow: 4px 0 0 -3px var(--accent); }
  .practice-mark-2 i { width: 108px; height: 108px; border-color: var(--text-muted); border-radius: 50%; box-shadow: 0 0 0 18px rgba(236,229,214,.025), 0 0 0 38px rgba(236,229,214,.02); }
  .practice-mark-3 { grid-template-columns: repeat(7, 9px); align-content: center; justify-content: center; gap: 6px; transform: rotate(-4deg); }
  .practice-mark-3 i { width: 8px; height: 8px; border: 0; background: var(--accent); opacity: .18; }
  .practice-mark-3 i:nth-child(3n), .practice-mark-3 i:nth-child(7n) { opacity: .85; transform: scale(1.35); }
  .practice-card h3 { margin: 0 0 14px; font-size: 31px; font-weight: 400; }
  .practice-card > p { margin: 0; color: var(--text-body); font-size: 16px; line-height: 1.65; }
  .field-note-section { background: var(--accent); color: var(--ink); overflow: hidden; }
  .field-note-grid { min-height: 530px; padding-top: 88px; padding-bottom: 88px; display: grid; grid-template-columns: 160px minmax(400px, 1fr) 330px; gap: 52px; align-items: center; }
  .field-note-label { align-self: start; display: flex; flex-direction: column; gap: 10px; font: 10px/1.2 var(--mono); letter-spacing: .16em; text-transform: uppercase; }
  .field-note-label span:last-child { font: 32px/1 'Newsreader', serif; }
  blockquote { margin: 0; position: relative; z-index: 2; }
  blockquote p { max-width: 720px; margin: 0 0 28px; font-size: clamp(40px, 5vw, 68px); line-height: 1.02; letter-spacing: -.035em; }
  blockquote footer { font: 11px/1.5 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .impact-field { display: grid; grid-template-columns: repeat(9, 10px); gap: 16px; transform: rotate(7deg); opacity: .65; }
  .impact-field i { width: 10px; height: 10px; border: 1px solid var(--ink); border-radius: 50%; transform: scale(calc(.55 + (var(--i) % 5) * .11)); }
  .impact-field i:nth-child(4n) { background: var(--ink); }
  @media (max-width: 900px) {
    .hero-trace { left: 42%; opacity: .52; }.definition-grid { grid-template-columns: 1fr; gap: 36px; }.practice-sequence { grid-template-columns: 1fr; }
    .practice-card, .practice-card:first-child { min-height: auto; border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); }.field-note-grid { grid-template-columns: 110px 1fr; }.impact-field { display: none; }
  }
  @media (max-width: 640px) {
    .home-hero, .hero-inner { min-height: 650px; }.hero-inner { padding-top: 82px; padding-bottom: 72px; align-items: flex-start; }h1 { font-size: 51px; }.hero-copy > p { font-size: 18px; }
    .hero-trace { inset: 22% -35% 0 25%; opacity: .4; }.definition-grid { padding-top: 76px; padding-bottom: 78px; }.practice-section { padding: 78px 0 84px; }.section-heading > span { display: none; }
    .practice-card { padding: 26px 24px 34px; }.field-note-grid { min-height: 470px; padding-top: 64px; padding-bottom: 68px; grid-template-columns: 1fr; gap: 42px; }blockquote p { font-size: 42px; }
  }
</style>
