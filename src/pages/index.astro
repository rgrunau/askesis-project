---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUBSTACK_URL, hero, recognition, method, story, closing } from '../data/start';

const isTodo = (s: string) => s.startsWith('TODO');
// Unfinished (TODO) copy shows as a dashed box in `npm run dev` only.
// In the production build it is simply left out.
const show = (s: string) => import.meta.env.DEV || !isTodo(s);

const recLines = recognition.lines.filter(show);
const hasRec = recognition.visible && recLines.length > 0;
const hasMethod = method.visible;
const hasStory = story.visible;
const hasCloseNote = closing.visible && show(closing.note);

// Number the visible sections in page order: 01, 02, ...
const numbered = [hasRec && 'rec', hasMethod && 'method', hasStory && 'story'].filter(Boolean);
const idx = (key: string) => String(numbered.indexOf(key) + 1).padStart(2, '0');

const hasHeading = show(hero.heading);
---

<BaseLayout title="The Askesis Project" currentPage="/" minimal noindex>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />

  <header class="start-top">
    <div class="wrapper top-row">
      <span class="brand">The Askesis Project</span>
    </div>
  </header>

  <section class:list={['start-hero', { bare: !hasHeading }]}>
    <div class="rings-frame" aria-hidden="true"><img class="rings" src="/hero-rings-handdrawn.svg" alt="" /></div>
    <div class="wrapper hero-inner">
      <div class="kicker">{hero.eyebrow}</div>
      {hasHeading && <h1 class:list={{ todo: isTodo(hero.heading) }}>{hero.heading}</h1>}
      {show(hero.sub) && <p class:list={['hero-sub', { todo: isTodo(hero.sub) }]}>{hero.sub}</p>}
      <a class="btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">{hero.cta} →</a>
    </div>
  </section>

  {hasRec && (
    <section class="start-section alt">
      <div class="wrapper narrow">
        <div class="index"><span>{idx('rec')}</span><span>{recognition.label}</span></div>
        <div class="lines">
          {recLines.map((line) => <p class:list={['line', { todo: isTodo(line) }]}>{line}</p>)}
        </div>
      </div>
    </section>
  )}

  {hasMethod && (
  <section class="start-section">
    <div class="wrapper narrow">
      <div class="index"><span>{idx('method')}</span><span>{method.label}</span></div>
      {show(method.intro) && <p class:list={['method-intro', { todo: isTodo(method.intro) }]}>{method.intro}</p>}
      <ol class="steps">
        {method.steps.map((step, i) => (
          <li>
            <span class="step-n">0{i + 1}</span>
            <h3>{step.label}</h3>
            <p class:list={{ todo: isTodo(step.note) }}>{step.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  )}

  {hasStory && (
  <section class="start-section alt">
    <div class="wrapper narrow">
      <div class="index"><span>{idx('story')}</span><span>{story.label}</span></div>
      <p class="story">{story.body}</p>
      <p class="bridge">{story.bridge}</p>
      {show(story.after) && <p class:list={['story-after', { todo: isTodo(story.after) }]}>{story.after}</p>}
    </div>
  </section>
  )}

  <section class="start-close">
    <div class="wrapper narrow">
      {hasCloseNote && <p class:list={['close-note', { todo: isTodo(closing.note) }]}>{closing.note}</p>}
      <a class="btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">{closing.cta} →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .start-top { border-bottom: 1px solid var(--line); }
  .top-row { padding-top: 20px; padding-bottom: 20px; }
  .brand { font: 11px/1 var(--mono); letter-spacing: .2em; text-transform: uppercase; color: var(--text-muted); }

  .start-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  /* The rings sit inside a centered column that matches the page width,
     so they stay near the content on wide screens. */
  .rings-frame { position: absolute; top: 0; bottom: 0; left: 0; right: 0; max-width: 1200px; margin: 0 auto; pointer-events: none; }
  .rings { position: absolute; right: -22%; top: -6%; width: min(110vw, 700px); aspect-ratio: 1; opacity: .35; }
  .hero-inner { position: relative; z-index: 1; padding-top: 72px; padding-bottom: 80px; }
  .hero-inner > * { max-width: 820px; }
  .kicker { font: 11px/1.4 var(--mono); letter-spacing: .24em; text-transform: uppercase; color: var(--accent); margin-bottom: 28px; }
  h1 { margin: 0 0 28px; font-family: 'Instrument Serif', 'Newsreader', serif; font-weight: 400; font-size: clamp(46px, 9.5vw, 92px); line-height: 1.02; letter-spacing: -.02em; text-wrap: balance; }
  /* No headline yet (production while it is a TODO): tighten the hero so the
     kicker, rings and button read as a deliberate band, not an empty one. */
  .start-hero.bare .hero-inner { padding-top: 56px; padding-bottom: 64px; }
  .start-hero.bare .kicker { margin-bottom: 32px; }
  .hero-sub { margin: 0 0 36px; max-width: 540px; color: var(--text-body); font-size: 19px; line-height: 1.6; }

  .start-section { padding: 72px 0; border-bottom: 1px solid var(--line); }
  .start-section.alt { background: var(--bg-alt); }
  .narrow > * { max-width: 760px; }
  .index { display: flex; gap: 18px; margin-bottom: 32px; font: 10px/1 var(--mono); letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
  .lines { display: grid; gap: 18px; }
  .line { margin: 0; font-family: 'Instrument Serif', 'Newsreader', serif; font-size: clamp(28px, 5vw, 40px); line-height: 1.2; }

  .method-intro { margin: 0 0 36px; color: var(--text-body); font-size: 19px; line-height: 1.6; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 56px 1fr; column-gap: 12px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .step-n { grid-row: 1 / span 2; font: 11px/2.6 var(--mono); letter-spacing: .14em; color: var(--accent); }
  .steps h3 { margin: 0 0 8px; font-family: 'Instrument Serif', 'Newsreader', serif; font-weight: 400; font-size: 36px; line-height: 1.1; }
  .steps p { margin: 0; color: var(--text-body); font-size: 17px; line-height: 1.6; }

  .story { margin: 0 0 28px; color: var(--text-body); font-size: 20px; line-height: 1.7; }
  .bridge { margin: 0 0 28px; font-family: 'Instrument Serif', 'Newsreader', serif; font-size: clamp(28px, 5vw, 38px); line-height: 1.2; color: var(--text); }
  .story-after { margin: 0; color: var(--text-body); font-size: 20px; line-height: 1.7; }

  .start-close { padding: 84px 0 96px; }
  .close-note { margin: 0 0 32px; max-width: 540px; color: var(--text-body); font-size: 19px; line-height: 1.6; }

  /* Placeholders for unwritten copy: visible on purpose. */
  .todo { border: 1px dashed var(--accent); padding: 10px 12px; color: var(--accent) !important; font: 12px/1.5 var(--mono) !important; letter-spacing: .02em; }

  @media (min-width: 900px) {
    .rings { right: 0; top: 6%; width: 560px; }
    .hero-inner { padding-top: 120px; padding-bottom: 130px; }
    .start-hero.bare .hero-inner { padding-top: 88px; padding-bottom: 96px; }
    .start-section { padding: 104px 0; }
    .steps { grid-template-columns: repeat(3, 1fr); border-top: 0; }
    .steps li { display: block; padding: 28px 28px 34px; border: 0; border-top: 1px solid var(--line); border-right: 1px solid var(--line); }
    .steps li:first-child { border-left: 1px solid var(--line); }
    .step-n { display: block; margin-bottom: 18px; line-height: 1; }
  }
</style>
